# ===== دليني الأقصى - إعدادات الخادم =====
PORT=10000
NODE_ENV=production

# قاعدة بيانات PostgreSQL (اتركها فارغة للتجربة بالذاكرة فقط)
DATABASE_URL=

# سر لتشفير رموز الاسترجاع (اجعله نصاً طويلاً عشوائياً)
CODE_SECRET=

# إرسال البريد (اختر واحداً: Resend أو Brevo)
EMAIL_FROM=Dalini Aqsa <no-reply@your-domain.com>
RESEND_API_KEY=
BREVO_API_KEY=

# للتجربة المحلية فقط: يعيد رمز الاسترجاع في الاستجابة. لا يعمل مع NODE_ENV=production
RESET_DEMO_MODE=false

# بريد المدير للوصول إلى /admin
ADMIN_EMAIL=
